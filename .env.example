# Telegram bot tokens — get from @BotFather
TG_BOT_TOKEN=                    # claude-agent.sh
CAL_TG_BOT_TOKEN=                # claude-calendar-bot.sh
OC_TG_BOT_TOKEN=                 # opencode-agent.sh

# Your Telegram chat ID (find via @userinfobot)
TG_CHAT_ID=
ALLOWED_CHAT_IDS=                # comma-separated whitelist; defaults to TG_CHAT_ID

# Calendar/Finance API JWT (only needed for claude-calendar-bot.sh)
CAL_API_TOKEN=

# Optional: ntfy.sh topic for claude-agent.sh
NTFY_TOPIC=
